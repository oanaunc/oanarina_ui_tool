{
  "name": "oanarina-ui-tool",
  "version": "0.2.0-dev.2",
  "private": true,
  "description": "A local-first interface design studio for Mac",
  "author": "Oana Rinaldi",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/bundle-plugin.mjs && node scripts/build-command-registry.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "desktop": "bash scripts/build-mac.sh && open \"build/Oanarina UI Tool.app\"",
    "package:mac": "bash scripts/package-mac.sh",
    "test:e2e": "playwright test",
    "inventory": "node scripts/inventory.mjs",
    "build:mac": "bash scripts/build-mac.sh",
    "desktop:electron": "npm run build && electron ."
  },
  "dependencies": {
    "gifenc": "^1.0.3",
    "lucide-react": "^0.577.0",
    "paper": "^0.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.oanarinaldi.uitool",
    "productName": "Oanarina UI Tool",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "identity": null,
      "minimumSystemVersion": "13.0.0"
    },
    "dmg": {
      "title": "Oanarina UI Tool",
      "contents": [
        {
          "x": 130,
          "y": 170
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "oui",
        "name": "Oanarina Design Project",
        "role": "Editor"
      }
    ]
  }
}
